# 複製這個檔案成 .env.local，填入真正的值（.env.local 不會被 git 提交）

# MongoDB 連線字串（MongoDB Atlas → Connect → Drivers）
# 網址最後的 /collab-office 是資料庫名稱，避免和其他專案混在一起
MONGODB_URI=mongodb+srv://<帳號>:<密碼>@<cluster>.mongodb.net/collab-office

# Vercel Blob 讀寫金鑰（Vercel 後台 → Storage → Blob → .env.local 分頁）
BLOB_READ_WRITE_TOKEN=

# AI 模型金鑰
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 會員登入（Better Auth）
# 產生方式：在終端機執行 openssl rand -base64 32
BETTER_AUTH_SECRET=
# 網站的網址（本機開發用 http://localhost:3001，部署後改成正式網址）
BETTER_AUTH_URL=http://localhost:3001

# Google 登入（Google Cloud Console → API 和服務 → 憑證 → OAuth 用戶端 ID）
# 「已授權的重新導向 URI」要加上：<BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
